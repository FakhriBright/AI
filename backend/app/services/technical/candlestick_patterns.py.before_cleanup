"""Deterministic candlestick pattern recognition on CLOSED OHLC candles.

Patterns are observations, not trade signals. Context, location and follow-through
must be evaluated separately by the scenario engine.
"""
from typing import Literal
from pydantic import BaseModel
from app.services.market_data.base import Candle

Direction = Literal["bullish", "bearish", "neutral"]
Strength = Literal["weak", "moderate", "strong"]

class PatternResult(BaseModel):
    name: str
    direction: Direction
    strength: Strength
    reasons: list[str]
    impact: str = "Context clue only; wait for follow-through."
    confirmation: str = "Require a subsequent closed candle or structure confirmation."


def _c(c: Candle):
    return (float(c.open), float(c.high), float(c.low), float(c.close))

def _body(c: Candle) -> float:
    return abs(c.close - c.open)

def _rng(c: Candle) -> float:
    return max(0.0, c.high - c.low)

def _bull(c: Candle) -> bool: return c.close > c.open
def _bear(c: Candle) -> bool: return c.close < c.open
def _mid(c: Candle) -> float: return (c.open + c.close) / 2

def _add(out, name, direction, strength, reason, confirmation=None):
    out.append(PatternResult(name=name, direction=direction, strength=strength,
        reasons=[reason], impact=("Potential bullish rejection/reversal; not a standalone buy." if direction == "bullish" else "Potential bearish rejection/reversal; not a standalone sell." if direction == "bearish" else "Indecision/compression; wait for range resolution."),
        confirmation=confirmation or ("Wait for bullish structure break or a follow-through close above the pattern high." if direction == "bullish" else "Wait for bearish structure break or a follow-through close below the pattern low." if direction == "bearish" else "Wait for a decisive close outside the pattern range.")))

def detect_patterns(candles: list[Candle], at_zone: bool = False) -> list[PatternResult]:
    """Detect common 1â€“3 candle patterns. Pass only completed candles, oldest first."""
    if not candles: return []
    out: list[PatternResult] = []
    c = candles[-1]; p = candles[-2] if len(candles) > 1 else None
    pp = candles[-3] if len(candles) > 2 else None
    r = _rng(c)
    if r <= 0: return out
    b = _body(c); uw = c.high - max(c.open, c.close); lw = min(c.open, c.close) - c.low
    small = b <= .30*r
    loc = " at a supplied key zone" if at_zone else ""
    # Single-candle rejection and indecision forms
    if small and lw >= 2*max(b, r*.01) and uw <= .35*r:
        _add(out, "hammer", "bullish", "strong" if at_zone else "moderate", f"Small body, long lower wick{loc}")
        _add(out, "pin_bar", "bullish", "strong" if at_zone else "moderate", "Lower-wick rejection")
    if small and uw >= 2*max(b, r*.01) and lw <= .35*r:
        _add(out, "inverted_hammer", "bullish", "moderate", f"Long upper wick with compact body{loc}")
        _add(out, "shooting_star", "bearish", "strong" if at_zone else "moderate", f"Long upper wick rejection{loc}")
        _add(out, "pin_bar", "bearish", "moderate", "Upper-wick rejection")
    if b <= .10*r:
        if uw <= .10*r and lw >= .65*r:
            _add(out, "dragonfly_doji", "bullish", "moderate", "Doji with dominant lower shadow")
        elif lw <= .10*r and uw >= .65*r:
            _add(out, "gravestone_doji", "bearish", "moderate", "Doji with dominant upper shadow")
        elif .35*r <= uw <= .65*r and .35*r <= lw <= .65*r:
            _add(out, "long_legged_doji", "neutral", "moderate", "Tiny body and extended two-sided shadows")
        else:
            _add(out, "doji", "neutral", "weak", "Open and close are nearly equal")
    if b <= .08*r and uw <= .08*r and lw <= .08*r:
        _add(out, "four_price_doji", "neutral", "weak", "OHLC compressed to nearly one price")
    if b >= .88*r:
        _add(out, "marubozu", "bullish" if _bull(c) else "bearish" if _bear(c) else "neutral", "strong", "Body dominates range with very short shadows")
    if .1*r < b <= .35*r and uw >= .2*r and lw >= .2*r:
        _add(out, "spinning_top", "neutral", "weak", "Small real body with shadows on both sides")
    if p:
        pr = _rng(p); pb = _body(p)
        if c.high <= p.high and c.low >= p.low:
            _add(out, "inside_bar", "neutral", "moderate", "Current range contained by previous range", "Wait for a closed breakout; retest is preferable to a wick-only breach.")
        if _bull(c) and _bear(p) and c.open <= p.close and c.close >= p.open and b >= pb:
            _add(out, "bullish_engulfing", "bullish", "strong" if at_zone else "moderate", "Bullish body engulfs prior bearish body")
            _add(out, "engulfing", "bullish", "strong" if at_zone else "moderate", "Bullish body engulfs prior bearish body")
        if _bear(c) and _bull(p) and c.open >= p.close and c.close <= p.open and b >= pb:
            _add(out, "bearish_engulfing", "bearish", "strong" if at_zone else "moderate", "Bearish body engulfs prior bullish body")
            _add(out, "engulfing", "bearish", "strong" if at_zone else "moderate", "Bearish body engulfs prior bullish body")
        # Harami: small current body inside prior body
        if pb > 0 and b < pb*.6 and min(c.open,c.close) >= min(p.open,p.close) and max(c.open,c.close) <= max(p.open,p.close):
            _add(out, "bullish_harami" if _bear(p) else "bearish_harami" if _bull(p) else "harami", "bullish" if _bear(p) else "bearish" if _bull(p) else "neutral", "moderate", "Small real body contained in previous larger body")
        if _bull(c) and _bear(p) and c.open < p.low and c.close > _mid(p) and c.close < p.open:
            _add(out, "piercing_line", "bullish", "moderate", "Bullish close pierces beyond midpoint of prior bearish body")
        if _bear(c) and _bull(p) and c.open > p.high and c.close < _mid(p) and c.close > p.open:
            _add(out, "dark_cloud_cover", "bearish", "moderate", "Bearish close penetrates prior bullish body midpoint")
        if abs(c.low-p.low) <= .10*max(pr,r) and _bear(p) and _bull(c):
            _add(out, "matching_low", "bullish", "weak", "Two lows align closely with opposite candle directions")
        if abs(c.high-p.high) <= .10*max(pr,r) and _bull(p) and _bear(c):
            _add(out, "matching_high", "bearish", "weak", "Two highs align closely with opposite candle directions")
        if abs(c.low-p.low) <= .08*max(pr,r):
            _add(out, "tweezer_bottom", "bullish", "moderate", "Consecutive lows align within tolerance")
        if abs(c.high-p.high) <= .08*max(pr,r):
            _add(out, "tweezer_top", "bearish", "moderate", "Consecutive highs align within tolerance")
        if _bull(c) and _bear(p) and c.open >= p.open and c.close >= p.close and abs(c.open-p.open) <= .1*max(pr,r):
            _add(out, "bullish_kicker", "bullish", "moderate", "Strong bullish directional shift; gap criterion may be absent in FX/CFD")
        if _bear(c) and _bull(p) and c.open <= p.open and c.close <= p.close and abs(c.open-p.open) <= .1*max(pr,r):
            _add(out, "bearish_kicker", "bearish", "moderate", "Strong bearish directional shift; gap criterion may be absent in FX/CFD")
        if _bull(c) and _bear(p) and abs(c.open-p.close) <= .08*max(pr,r) and c.close > p.high:
            _add(out, "bullish_belt_hold", "bullish", "moderate", "Bullish candle opens near prior close and closes strongly near high")
        if _bear(c) and _bull(p) and abs(c.open-p.close) <= .08*max(pr,r) and c.close < p.low:
            _add(out, "bearish_belt_hold", "bearish", "moderate", "Bearish candle opens near prior close and closes strongly near low")
        if abs(c.low-p.low) <= .08*max(pr,r) and _bull(c) and _bear(p):
            _add(out, "tweezers", "bullish", "weak", "Matching lows form a potential bottom")
        if abs(c.high-p.high) <= .08*max(pr,r) and _bear(c) and _bull(p):
            _add(out, "tweezers", "bearish", "weak", "Matching highs form a potential top")
    if pp and p:
        # Three-candle star families; middle body small, first/last opposite
        mid_small = _body(p) <= .35*max(_rng(p), 1e-12)
        if _bear(pp) and mid_small and _bull(c) and c.close > _mid(pp):
            _add(out, "morning_star", "bullish", "strong" if at_zone else "moderate", "Bearish impulse, pause, then bullish recovery beyond first-body midpoint")
        if _bull(pp) and mid_small and _bear(c) and c.close < _mid(pp):
            _add(out, "evening_star", "bearish", "strong" if at_zone else "moderate", "Bullish impulse, pause, then bearish recovery beyond first-body midpoint")
        if _bear(pp) and mid_small and _bull(c) and _body(p) <= .10*max(_rng(p),1e-12):
            _add(out, "morning_doji_star", "bullish", "moderate", "Morning-star form with doji middle candle")
        if _bull(pp) and mid_small and _bear(c) and _body(p) <= .10*max(_rng(p),1e-12):
            _add(out, "evening_doji_star", "bearish", "moderate", "Evening-star form with doji middle candle")
        if (
            _bear(pp)
            and _bull(p)
            and _bull(c)
            and p.open < pp.close
            and p.close > pp.open
            and c.close > p.close
        ):
            _add(out, "three_inside_up", "bullish", "moderate", "Harami-like pause followed by bullish confirmation")
        if _bull(pp) and _bear(p) and _bear(c) and p.open > pp.close and p.close < pp.open and c.close < pp.close:
            _add(out, "three_inside_down", "bearish", "moderate", "Harami-like pause followed by bearish confirmation")
        if _bull(pp) and _bull(p) and _bull(c) and pp.close < p.close < c.close and pp.open < p.open < c.open:
            _add(out, "three_white_soldiers", "bullish", "moderate", "Three rising bullish bodies; check for late-entry extension")
        if _bear(pp) and _bear(p) and _bear(c) and pp.close > p.close > c.close and pp.open > p.open > c.open:
            _add(out, "three_black_crows", "bearish", "moderate", "Three falling bearish bodies; check for downside extension")
    # Deduplicate aliases while retaining distinct named pattern categories.
    seen = set(); unique = []
    for item in out:
        key = (item.name, item.direction)
        if key not in seen:
            seen.add(key); unique.append(item)
    return unique
