# Copy to .env and fill in real values. Never commit the real .env.

# --- Database ---
POSTGRES_USER=trading_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trading_analysis
DATABASE_URL=postgresql://trading_app:changeme@postgres:5432/trading_analysis

# --- Market data provider ---
MARKET_DATA_PROVIDER=mt5_bridge
# Dev on Windows + Docker Desktop: containers reach the host via this hostname.
MT5_BRIDGE_URL=http://host.docker.internal:8765

# --- AI provider (provider-agnostic; value selects the concrete implementation) ---
# Server default for users who have not saved a choice in Settings > AI Provider.
# One of: groq, gemini, openrouter (mock for offline tests). See docs/ai-providers.md.
AI_PROVIDER=groq
# Legacy name for the Gemini key, only read when GEMINI_API_KEY is empty.
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=90
# Output-token allowance for hidden reasoning/thinking, added to each request's
# max_tokens for Groq, Gemini and OpenRouter (see docs/ai-providers.md).
AI_REASONING_TOKENS=6144

# --- Multi-provider selector / Auto Switch ---
AI_FALLBACK_ORDER=groq,gemini,openrouter
AI_FALLBACK_MAX_ATTEMPTS=3
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_MODEL_CACHE_SECONDS=600

# --- Groq provider ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional comma-separated allowlist; narrows the models discovered for the key.
GROQ_MODELS=

# --- Google Gemini provider ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=

# --- OpenRouter provider (OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model (no built-in default). Free-tier keys can only use ":free" models.
OPENROUTER_MODEL=
OPENROUTER_MODELS=

# --- Auth (values only matter once the auth-model decision is made) ---
JWT_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://10.52.102.95:5173

# --- Frontend ---
VITE_API_URL=http://10.52.102.95:8000
VITE_API_BASE_URL=http://10.52.102.95:8000

LOG_LEVEL=info
