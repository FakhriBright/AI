# Copy to .env and fill in real values. Never commit the real .env.

# --- Database ---
POSTGRES_USER=trading_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trading_analysis
DATABASE_URL=postgresql://trading_app:changeme@postgres:5432/trading_analysis

# --- Market data provider ---
MARKET_DATA_PROVIDER=mt5_bridge
# Dev on Windows + Docker Desktop: containers reach the host via this hostname.
MT5_BRIDGE_URL=http://host.docker.internal:8765

# --- AI provider (provider-agnostic; value selects the concrete implementation) ---
AI_PROVIDER=gemini
AI_API_KEY=

# --- Groq provider (used when AI_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Auth (values only matter once the auth-model decision is made) ---
JWT_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://10.52.102.95:5173

# --- Frontend ---
VITE_API_URL=http://10.52.102.95:8000
VITE_API_BASE_URL=http://10.52.102.95:8000

LOG_LEVEL=info
